<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rivalo — Know When Your Market Moves</title>

    <meta
        name="description"
        content="Rivalo monitors competitor product pages for price and availability changes, stores historical snapshots, and alerts you when supported changes are detected."
    >

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="icon" type="image/png" href="/favicon.png">

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/landing.css">
</head>

<body>

<header class="landing-nav">
    <div class="nav-container">

        <a href="/" class="brand">
            <span class="brand-mark">
                <img src="/favicon.png" alt="Rivalo">
            </span>
            <span>Rivalo</span>
        </a>

        <nav class="desktop-nav">
            <a href="#how-it-works">How it works</a>
            <a href="#features">Features</a>
            <a href="/#waitlist">Early access</a>
        </nav>

        <div class="nav-actions">
            <a href="/auth/login" class="login-link">Log in</a>

            <% if (isAuthenticated) { %>
                <a href="/competitors" class="monitoring-button">
                    Start Monitoring
                </a>
            <% } else { %>
                <a href="/auth/register" class="monitoring-button">
                    Start Monitoring
                </a>
            <% } %>
        </div>

        <form action="/auth/logout" method="POST" class="logout-link" style="display: inline;">
            <button type="submit">Logout</button>
        </form>

    </div>
</header>

<main>

    <!-- HERO -->
    <section class="hero">

        <div class="hero-grid">

            <div class="hero-content">

                <div class="eyebrow">
                    <span class="eyebrow-dot"></span>
                    COMPETITOR MONITORING
                </div>

                <h1>
                    Know when
                    <span>the market moves.</span>
                </h1>

                <p class="hero-description">
                    Rivalo watches the competitor product pages you choose,
                    records the information it can reliably detect, and helps
                    you spot meaningful price and availability changes over time.
                </p>

                <div class="hero-actions">

                    <% if (isAuthenticated) { %>
                        <a href="/competitors" class="monitoring-button hero-button">
                            Start Monitoring
                            <span>↗</span>
                        </a>
                    <% } else { %>
                        <a href="/auth/register" class="monitoring-button hero-button">
                            Start Monitoring
                            <span>↗</span>
                        </a>
                    <% } %>

                    <a href="#how-it-works" class="secondary-button">
                        See how it works
                        <span>↓</span>
                    </a>

                </div>

                <div class="hero-proof">

                    <div class="proof-item">
                        <strong>Scheduled</strong>
                        <span>automatic checks</span>
                    </div>

                    <div class="proof-divider"></div>

                    <div class="proof-item">
                        <strong>Snapshots</strong>
                        <span>kept over time</span>
                    </div>

                    <div class="proof-divider"></div>

                    <div class="proof-item">
                        <strong>Alerts</strong>
                        <span>when changes are detected</span>
                    </div>

                </div>

            </div>


            <!-- PRODUCT VISUAL -->
            <div class="hero-product">

                <div class="visual-orbit orbit-one"></div>
                <div class="visual-orbit orbit-two"></div>

                <div class="monitor-card">

                    <div class="monitor-card-top">
                        <div class="monitor-status">
                            <span class="status-pulse"></span>
                            MONITORED PRODUCT
                        </div>

                        <span class="monitor-menu">•••</span>
                    </div>

                    <div class="url-field">
                        <span class="url-icon">↗</span>
                        <span>competitor.com/products/example-product</span>
                    </div>

                    <div class="monitor-product">

                        <div class="product-placeholder">
                            <div class="product-placeholder-inner"></div>
                        </div>

                        <div class="monitor-product-info">
                            <span class="mini-label">PRODUCT PAGE</span>
                            <h3>Example Product</h3>
                            <p>Specific product URL</p>
                        </div>

                    </div>

                    <div class="detected-grid">

                        <div class="detected-item">
                            <span>PRICE</span>
                            <strong>Detected</strong>
                            <small>when available</small>
                        </div>

                        <div class="detected-item">
                            <span>AVAILABILITY</span>
                            <strong class="unknown-value">Unknown</strong>
                            <small>when page cannot confirm</small>
                        </div>

                    </div>

                    <div class="monitor-footer">

                        <div>
                            <span class="mini-label">SNAPSHOT</span>
                            <strong>Stored automatically</strong>
                        </div>

                        <div class="snapshot-icon">
                            ✓
                        </div>

                    </div>

                </div>


                <div class="pipeline-card">

                    <div class="pipeline-title">
                        <span>MONITORING FLOW</span>
                        <span class="pipeline-line"></span>
                    </div>

                    <div class="pipeline">

                        <div class="pipeline-step active">
                            <span>01</span>
                            <strong>CHECK</strong>
                        </div>

                        <div class="pipeline-connector"></div>

                        <div class="pipeline-step active">
                            <span>02</span>
                            <strong>SNAPSHOT</strong>
                        </div>

                        <div class="pipeline-connector"></div>

                        <div class="pipeline-step">
                            <span>03</span>
                            <strong>COMPARE</strong>
                        </div>

                        <div class="pipeline-connector"></div>

                        <div class="pipeline-step">
                            <span>04</span>
                            <strong>ALERT</strong>
                        </div>

                    </div>

                </div>


                <div class="floating-state">

                    <span class="floating-state-dot"></span>

                    <div>
                        <small>DETECTION STATE</small>
                        <strong>Only report what the page supports.</strong>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- MARKET STRIP -->
    <section class="market-strip">

        <div class="market-strip-inner">

            <span class="market-strip-label">
                MONITOR WHAT MATTERS
            </span>

            <div class="market-item">
                <span class="market-icon">↕</span>
                Price changes
            </div>

            <div class="market-item">
                <span class="market-icon">◉</span>
                Stock availability
            </div>

            <div class="market-item">
                <span class="market-icon">□</span>
                Product data
            </div>

            <div class="market-item">
                <span class="market-icon">!</span>
                Change alerts
            </div>

            <div class="market-item">
                <span class="market-icon">↗</span>
                Historical snapshots
            </div>

        </div>

    </section>


 


    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="how-section">

        <div class="section-heading">

            <div>
                <span class="section-eyebrow">HOW IT WORKS</span>

                <h2>
                    One setup.
                    <span>Then it keeps watching.</span>
                </h2>
            </div>

            <p>
                Rivalo turns a competitor product URL into a monitored
                product. Scheduled checks collect fresh snapshots so
                changes can be compared over time.
            </p>

        </div>


        <div class="steps">

            <article class="step">

                <div class="step-top">
                    <div class="step-number">01</div>
                    <span class="step-arrow">↗</span>
                </div>

                <div class="step-visual step-url">
                    <span class="visual-dot"></span>
                    competitor.com
                </div>

                <h3>Add a competitor</h3>

                <p>
                    Enter the competitor website you want to monitor.
                </p>

                <div class="step-example">
                    COMPETITOR WEBSITE
                </div>

            </article>


            <article class="step">

                <div class="step-top">
                    <div class="step-number">02</div>
                    <span class="step-arrow">↗</span>
                </div>

                <div class="step-visual step-product">

                    <div class="tiny-product"></div>

                    <div>
                        <strong>Product URL</strong>
                        <small>Specific page</small>
                    </div>

                </div>

                <h3>Add a product</h3>

                <p>
                    Give Rivalo the specific product page you want to track.
                </p>

                <div class="step-example">
                    PRODUCT PAGE
                </div>

            </article>


            <article class="step">

                <div class="step-top">
                    <div class="step-number">03</div>
                    <span class="step-arrow">↗</span>
                </div>

                <div class="step-visual step-check">

                    <div class="check-ring">
                        ✓
                    </div>

                    <div>
                        <strong>Scheduled check</strong>
                        <small>Fresh snapshot</small>
                    </div>

                </div>

                <h3>Monitor automatically</h3>

                <p>
                    Scheduled checks revisit the product and store fresh
                    snapshots of detected information.
                </p>

                <div class="step-example">
                    CHECK → SNAPSHOT
                </div>

            </article>


            <article class="step">

                <div class="step-top">
                    <div class="step-number">04</div>
                    <span class="step-arrow">↗</span>
                </div>

                <div class="step-visual step-alert">

                    <span class="alert-symbol">!</span>

                    <div>
                        <strong>Change detected</strong>
                        <small>Review required</small>
                    </div>

                </div>

                <h3>React to changes</h3>

                <p>
                    Compare snapshots and receive supported price or
                    stock alerts when something changes.
                </p>

                <div class="step-example">
                    COMPARE → ALERT
                </div>

            </article>

        </div>

    </section>


    <!-- FEATURES -->
    <section id="features" class="features-section">

        <div class="section-heading centered">

            <span class="section-eyebrow">THE MONITOR</span>

            <h2>
                Less checking.
                <span>More signal.</span>
            </h2>

            <p>
                Rivalo focuses on the information you actually need
                from competitor product pages.
            </p>

        </div>


        <div class="feature-grid">


            <!-- PRICE -->
            <article class="feature feature-large">

                <div class="feature-copy">

                    <div class="feature-number">01</div>

                    <h3>Price monitoring</h3>

                    <p>
                        Detect price movement on the products you're
                        tracking and compare it against previous snapshots.
                    </p>

                </div>

                <div class="feature-visual price-visual">

                    <div class="price-window">

                        <div class="price-window-top">
                            <span>PRICE</span>
                            <span class="tiny-status">DETECTED</span>
                        </div>

                        <div class="price-display">
                            <span>Current detected price</span>
                            <strong>—</strong>
                        </div>

                        <div class="price-history-line">

                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>

                        </div>

                        <div class="price-history-labels">
                            <span>Previous snapshots</span>
                            <span>Latest</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- STOCK -->
            <article class="feature">

                <div class="feature-copy">

                    <div class="feature-number">02</div>

                    <h3>Availability</h3>

                    <p>
                        Record stock states when the product page provides
                        enough evidence to determine them.
                    </p>

                </div>

                <div class="stock-card">

                    <div class="stock-card-top">
                        <span>AVAILABILITY</span>
                        <span>PRODUCT PAGE</span>
                    </div>

                    <div class="stock-state">

                        <div class="state-circle">
                            ?
                        </div>

                        <div>
                            <strong>Unknown</strong>
                            <p>
                                No reliable availability signal detected.
                            </p>
                        </div>

                    </div>

                    <div class="stock-note">
                        Rivalo does not turn an unclear page into
                        a false out-of-stock result.
                    </div>

                </div>

            </article>


            <!-- HISTORY -->
            <article class="feature">

                <div class="feature-copy">

                    <div class="feature-number">03</div>

                    <h3>Historical snapshots</h3>

                    <p>
                        Keep previous product observations so you can
                        understand what changed instead of relying on memory.
                    </p>

                </div>

                <div class="history-card">

                    <div class="history-header">
                        <span>SNAPSHOT HISTORY</span>
                        <span>NEWEST</span>
                    </div>

                    <div class="history-row">
                        <span class="history-marker"></span>
                        <div>
                            <strong>Latest snapshot</strong>
                            <small>Product data recorded</small>
                        </div>
                    </div>

                    <div class="history-row">
                        <span class="history-marker"></span>
                        <div>
                            <strong>Previous snapshot</strong>
                            <small>Stored for comparison</small>
                        </div>
                    </div>

                    <div class="history-row">
                        <span class="history-marker"></span>
                        <div>
                            <strong>Earlier snapshot</strong>
                            <small>Historical record</small>
                        </div>
                    </div>

                </div>

            </article>


            <!-- ALERTS -->
            <article class="feature feature-wide">

                <div class="feature-wide-copy">

                    <div class="feature-number">04</div>

                    <h3>Change alerts</h3>

                    <p>
                        You don't need to repeatedly open competitor pages.
                        When Rivalo detects a supported change, it can turn
                        that change into an email alert.
                    </p>

                    <div class="alert-types">
                        <span>Price drops</span>
                        <span>Price increases</span>
                        <span>Out of stock</span>
                        <span>Back in stock</span>
                    </div>

                </div>

                <div class="notification-stack">

                    <div class="notification-card">

                        <div class="notification-icon">
                            ↕
                        </div>

                        <div>
                            <small>PRICE CHANGE</small>
                            <strong>Change detected</strong>
                            <span>Review the latest snapshot.</span>
                        </div>

                    </div>

                    <div class="notification-card">

                        <div class="notification-icon">
                            ◉
                        </div>

                        <div>
                            <small>STOCK CHANGE</small>
                            <strong>Availability changed</strong>
                            <span>Only when reliably detected.</span>
                        </div>

                    </div>

                </div>

            </article>

        </div>

    </section>


    <!-- TRUTH / DETECTION -->
    <section class="truth-section">

        <div class="truth-grid">

            <div class="truth-copy">

                <span class="section-eyebrow">TRUTH BY DESIGN</span>

                <h2>
                    If the page doesn't know,
                    <span>neither should Rivalo.</span>
                </h2>

                <p>
                    Product pages don't always expose reliable availability
                    information. Rivalo keeps that uncertainty visible instead
                    of guessing.
                </p>

                <p>
                    That means an unclear product page can remain
                    <strong>Unknown</strong> rather than incorrectly being
                    reported as out of stock.
                </p>

            </div>


            <div class="truth-visual">

                <div class="truth-card">

                    <div class="truth-card-header">
                        <span>AVAILABILITY STATES</span>
                        <span>DETECTION</span>
                    </div>

                    <div class="truth-state reliable">

                        <span class="state-indicator"></span>

                        <div>
                            <strong>In stock</strong>
                            <small>Reliable signal detected</small>
                        </div>

                        <span class="state-label">
                            DETECTED
                        </span>

                    </div>

                    <div class="truth-state reliable">

                        <span class="state-indicator"></span>

                        <div>
                            <strong>Out of stock</strong>
                            <small>Reliable signal detected</small>
                        </div>

                        <span class="state-label">
                            DETECTED
                        </span>

                    </div>

                    <div class="truth-state uncertain">

                        <span class="state-indicator"></span>

                        <div>
                            <strong>Unknown</strong>
                            <small>Page did not provide enough evidence</small>
                        </div>

                        <span class="state-label">
                            NO GUESS
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- PROBLEM -->
    <section class="why-section">

        <div class="why-content">

            <span class="section-eyebrow">THE OLD WAY</span>

            <h2>
                Your competitors don't
                <span>announce when they change.</span>
            </h2>

            <p>
                A competitor can change a price, sell out of a product,
                or update a product page while you're focused on your own store.
            </p>

            <p>
                Manually checking every product doesn't scale.
            </p>

        </div>


        <div class="why-statement">

            <div class="manual-label">
                <span class="problem-dot"></span>
                MANUAL MONITORING
            </div>

            <div class="comparison-line">
                <span>Open websites</span>
                <strong>→</strong>
                <span>Check products</span>
                <strong>→</strong>
                <span>Record changes</span>
            </div>

            <div class="manual-time">
                <span>Repeated work</span>
                <strong>+</strong>
                <span>More products</span>
                <strong>+</strong>
                <span>More competitors</span>
            </div>

            <div class="automated-label">
                <span class="automation-dot"></span>
                WITH RIVALO
            </div>

            <div class="comparison-line automated">
                <span>Monitor once</span>
                <strong>→</strong>
                <span>Scheduled checks</span>
                <strong>→</strong>
                <span>See changes</span>
            </div>

        </div>

    </section>


    <!-- DATA SECTION -->
    <section class="data-section">

        <div class="data-section-heading">

            <span class="section-eyebrow">THE RESULT</span>

            <h2>
                Turn repeated checks into
                <span>a record of change.</span>
            </h2>

            <p>
                Each check contributes to a history of the product
                information Rivalo can detect.
            </p>

        </div>


        <div class="data-dashboard">

            <div class="data-dashboard-header">

                <div>
                    <span>MONITORING RECORD</span>
                    <strong>Product snapshots</strong>
                </div>

                <div class="record-badge">
                    SCHEDULED CHECKS
                </div>

            </div>


            <div class="record-flow">

                <div class="record-column">

                    <span class="record-index">01</span>

                    <div class="record-box">
                        <small>PRODUCT URL</small>
                        <strong>Specific product page</strong>
                        <span>Selected by you</span>
                    </div>

                </div>


                <div class="record-arrow">→</div>


                <div class="record-column">

                    <span class="record-index">02</span>

                    <div class="record-box">
                        <small>CHECK</small>
                        <strong>Fresh product data</strong>
                        <span>Detected from the page</span>
                    </div>

                </div>


                <div class="record-arrow">→</div>


                <div class="record-column">

                    <span class="record-index">03</span>

                    <div class="record-box">
                        <small>SNAPSHOT</small>
                        <strong>Stored observation</strong>
                        <span>Kept for comparison</span>
                    </div>

                </div>


                <div class="record-arrow">→</div>


                <div class="record-column">

                    <span class="record-index">04</span>

                    <div class="record-box">
                        <small>CHANGE</small>
                        <strong>Compare over time</strong>
                        <span>Alert when supported</span>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- FINAL CTA -->
<section class="final-cta">
    <div class="final-cta-inner">

    <div class="final-cta-label">
        <span class="final-cta-line"></span>
        KEEP WATCH
    </div>

    <div class="final-cta-main">

        <div class="final-cta-heading">
            <h2>
                Know when they
                <span>make a move.</span>
            </h2>

            <p>
                Choose the competitor products you care about.
                Rivalo checks them for you and tells you when something changes.
            </p>
        </div>

        <div class="final-cta-card">

            <div class="final-cta-card-top">
                <span>RIVALO</span>
                <span>COMPETITOR MONITOR</span>
            </div>

            <div class="final-cta-card-body">

                <div class="cta-mini-label">START MONITORING</div>

                <strong>
                    Pick a product.<br>
                    We'll watch it.
                </strong>

                <a href="/auth/register" class="cta-button">
                    Start monitoring
                    <span>↗</span>
                </a>

            </div>

            <div class="final-cta-card-bottom">
                <span>PRICE</span>
                <span>STOCK</span>
                <span>CHANGES</span>
                <span>ALERTS</span>
            </div>

        </div>
    </div>

    <div class="final-cta-footer">
        <span>SELECT</span>
        <span>MONITOR</span>
        <span>DETECT</span>
        <span>REACT</span>
    </div>

</div>

</section>


</main>


<!-- WAITLIST -->
<section id="waitlist" class="waitlist-section">

    <div class="section-heading centered">

        <span class="section-eyebrow">EARLY ACCESS</span>

        <h2>
            Reserve your spot,
            <span>save on launch pricing.</span>
        </h2>

        <p>
            Join the early access list and get 50% off your first
            3 months when we launch. No payment required today.
        </p>

    </div>


    <div class="waitlist-card">

        <% if (!isAuthenticated) { %>

            <p>
                Create an account or log in to reserve your Early Access spot.
            </p>

            <div class="waitlist-auth-actions">

                <a href="/auth/register" class="primary-button">
                    Create an account
                </a>

                <a href="/auth/login" class="waitlist-login">
                    Already have an account? Log in
                </a>

            </div>

        <% } else if (waitlistSignup) { %>

            <div class="waitlist-success">

                <div class="waitlist-success-icon">
                    ✓
                </div>

                <div>
                    <strong>You're already on the list.</strong>

                    <p>
                        Your Early Access spot is reserved.
                        We'll email you when Rivalo launches.
                    </p>
                </div>

            </div>

        <% } else { %>

            <form action="/waitlist" method="POST" class="waitlist-form">

                <input
                    type="email"
                    name="email"
                    placeholder="you@yourstore.com"
                    required
                >

                <input
                    type="url"
                    name="store_url"
                    placeholder="Your store URL (optional)"
                >

                <select name="feature_interest">

                    <option value="">
                        Which matters most to you?
                    </option>

                    <option value="price">
                        Price change alerts
                    </option>

                    <option value="stock">
                        Stock availability alerts
                    </option>

                    <option value="history">
                        Stock and price alerts and history
                    </option>

                </select>

                <button type="submit" class="primary-button">
                    Reserve your spot
                </button>

            </form>

        <% } %>


        <% if (typeof error !== 'undefined' && error) { %>

            <p class="waitlist-message error">
                <%= error %>
            </p>

        <% } %>

    </div>


    <footer>

        <div class="footer-container">

            <div class="footer-brand">

                <a href="/" class="brand">

                    <span class="brand-mark">
                        <img src="/favicon.png" alt="Rivalo">
                    </span>

                    <span>Rivalo</span>

                </a>

                <p>
                    Competitive intelligence for online stores.
                </p>

            </div>


            <div class="footer-links">

                <div>

                    <span>PRODUCT</span>

                    <a href="#features">Features</a>

                    <a href="#how-it-works">
                        How it works
                    </a>

                </div>


                <div>

                    <span>ACCOUNT</span>

                    <a href="/auth/login">
                        Log in
                    </a>

                    <a href="/auth/register">
                        Create account
                    </a>

                    <a href="/terms">
                        Terms of Service
                    </a>

                    <a href="/policy">
                        Privacy Policy
                    </a>

                </div>

            </div>

        </div>


        <div class="footer-bottom">

            <span>
                © <%= new Date().getFullYear() %> Rivalo
            </span>

            <span>
                Built for competitive businesses.
            </span>

        </div>

    </footer>

</body>
</html>