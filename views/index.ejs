                </div>
            </div>

            <div class="activity-change down">
                Price ↓ $20
            </div>

            <div class="activity-status">
                Detected
            </div>

        </div>


        <div class="activity-row">

            <div class="activity-product">
                <span>M</span>
                <div>
                    <strong>MacBook Air M4</strong>
                    <small>Apple</small>
                </div>
            </div>

            <div class="activity-change out">
                Out of stock
            </div>

            <div class="activity-status">
                Attention
            </div>

        </div>


        <div class="activity-row">

            <div class="activity-product">
                <span>S</span>
                <div>
                    <strong>WH-1000XM6</strong>
                    <small>Sony</small>
                </div>
            </div>

            <div class="activity-change up">
                Price ↑ $10
            </div>

            <div class="activity-status">
                Detected
            </div>

        </div>


        <div class="activity-row">

            <div class="activity-product">
                <span>N</span>
                <div>
                    <strong>Pegasus 41</strong>
                    <small>Nike</small>
                </div>
            </div>

            <div class="activity-change in">
                Back in stock
            </div>

            <div class="activity-status">
                Detected
            </div>

        </div>

    </div>

</div>


</section>


<!-- FINAL CTA -->

<section class="final-cta">


<div class="final-cta-grid">

    <div>

        <span class="section-eyebrow">
            READY?
        </span>

        <h2>
            Stop checking.
            <span>Start knowing.</span>
        </h2>

        <p>
            Put your competitor monitoring on autopilot
            and spend your time acting on the information.
        </p>

    </div>


    <div class="final-cta-action">

        <a href="/auth/register" class="cta-button">
            Create your account
            <span>↗</span>
        </a>

        <small>
            No complicated setup.
        </small>

    </div>

</div>


</section>

</main>
<!-- WAITLIST -->

<section id="waitlist" class="waitlist-section">

    <div class="section-heading centered">

        <span class="section-eyebrow">
            EARLY ACCESS
        </span>

        <h2>
            Reserve your spot,
            <span>save on launch pricing.</span>
        </h2>

        <p>
            Join the early access list and get 50% off your first
            3 months when we launch. No payment required today.
        </p>

    </div>

    <div class="waitlist-card">

        <form action="/waitlist" method="POST" class="waitlist-form">
            <input type="email" name="email" placeholder="you@yourstore.com" required>
            <input type="url" name="store_url" placeholder="Your store URL (optional)">
            <select name="feature_interest">
                <option value="">Which matters most to you?</option>
                <option value="price">Price change alerts</option>
                <option value="stock">Stock availability alerts</option>
                <option value="history">Stock and price alerts and history</option>
            </select>
            <button type="submit" class="primary-button">Reserve your spot</button>
        </form>

        <% if (typeof joined !== 'undefined' && joined) { %>
            <p class="waitlist-message success">You're on the list — we'll email you when we launch.</p>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="waitlist-message error"><%= error %></p>
        <% } %>

    </div>

</section>

<footer>

<div class="footer-container">

    <div class="footer-brand">

        <a href="/" class="brand">
            <span class="brand-mark">C</span>
            <span>Competitor Monitor</span>
        </a>

        <p>
            Competitive intelligence for online stores.
        </p>

    </div>


    <div class="footer-links">

        <div>

            <span>PRODUCT</span>

            <a href="#features">
                Features
            </a>

            <a href="#how-it-works">
                How it works
            </a>

            <a href="#pricing">
                Pricing
            </a>

        </div>


        <div>

            <span>ACCOUNT</span>

            <a href="/auth/login">
                Log in
            </a>

            <a href="/auth/register">
                Create account
            </a>

        </div>

    </div>

</div>


<div class="footer-bottom">

    <span>
        © <%= new Date().getFullYear() %> Competitor Monitor
    </span>

    <span>
        Built for competitive businesses.
    </span>

</div>


</footer>

</body>
</html>
