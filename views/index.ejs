<!-- HOW IT WORKS -->

<section id="how-it-works" class="how-section">

<div class="section-heading">

    <div>
        <span class="section-eyebrow">
            HOW IT WORKS
        </span>

        <h2>
            From URL to
            <span>competitive intelligence.</span>
        </h2>
    </div>

    <p>
        Set up a product once. Competitor Monitor handles the repetitive
        checking so you can focus on what the changes actually mean.
    </p>

</div>


<div class="steps">

    <article class="step">

        <div class="step-top">
            <div class="step-number">01</div>
            <span class="step-arrow">↗</span>
        </div>

        <div class="step-icon">+</div>

        <h3>
            Add a competitor
        </h3>

        <p>
            Enter the competitor website you want to monitor.
        </p>

        <div class="step-example">
            competitor.com
        </div>

    </article>


    <article class="step">

        <div class="step-top">
            <div class="step-number">02</div>
            <span class="step-arrow">↗</span>
        </div>

        <div class="step-icon">□</div>

        <h3>
            Add a product
        </h3>

        <p>
            Give us the product URL and select the information
            you want to monitor.
        </p>

        <div class="step-example">
            product / price / stock
        </div>

    </article>


    <article class="step">

        <div class="step-top">
            <div class="step-number">03</div>
            <span class="step-arrow">↗</span>
        </div>

        <div class="step-icon">◌</div>

        <h3>
            Monitor automatically
        </h3>

        <p>
            Scheduled checks collect fresh product data and
            store snapshots over time.
        </p>

        <div class="step-example">
            CHECK → RECORD → COMPARE
        </div>

    </article>


    <article class="step">

        <div class="step-top">
            <div class="step-number">04</div>
            <span class="step-arrow">↗</span>
        </div>

        <div class="step-icon">!</div>

        <h3>
            React to changes
        </h3>

        <p>
            See meaningful changes in your dashboard and get
            notified when something important happens.
        </p>

        <div class="step-example">
            CHANGE DETECTED
        </div>

    </article>

</div>


</section>

