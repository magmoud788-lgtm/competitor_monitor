<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit product</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel='stylesheet' href='/style.css'>
</head>

<body>

    <main>

        <h1>Edit Tracked Product</h1>

        <% if (error) { %>
            <p><%= error %></p>
        <% } %>

        <form
            action="/products/<%= product.id %>/edit"
            method="POST"
        >

            <div>
                <label for="name">
                    Product Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= product.name %>"
                    required
                >
            </div>

            <div>
                <label for="product_url">
                    Product URL
                </label>

                <input
                    type="url"
                    id="product_url"
                    name="product_url"
                    value="<%= product.product_url %>"
                    required
                >
            </div>

           

            <button type="submit">
                Save Changes
            </button>

        </form>

        <p>
            <a href="/products">Back to products</a>
        </p>

    </main>

</body>
</html>